{
  "rules": {
    "rooms": {
      // Allow authenticated users to read the rooms node (required for the invite code query to work)
      ".read": "auth != null",
      ".indexOn": ["meta/inviteCode"],

      "$roomId": {
        // Allow the initial room creation (when data doesn't exist) if the user sets themselves as admin
        ".write": "auth != null && !data.exists() && newData.child('meta/adminId').val() === auth.uid",

        "meta": {
          // Admin can update meta
          ".write": "auth != null && data.child('adminId').val() === auth.uid"
        },

        "participants": {
          // Any auth user can create their own participant record
          ".write": "auth != null",
          "$userId": {
            // Only the admin or the participant themselves can write
            ".write": "auth != null && (
              auth.uid === $userId ||
              root.child('rooms').child($roomId).child('meta/adminId').val() === auth.uid
            )"
          }
        },

        "playerPool": {
          // Allow captains to update player status during the draft
          ".write": "auth != null"
        },

        "draft": {
          // Any captain or admin can write to draft (game state transitions)
          ".write": "auth != null"
        },

        "log": {
          // Any authenticated user can append log entries
          ".write": "auth != null"
        },

        "presence": {
          // Each user manages their own presence
          "$userId": {
            ".write": "auth != null && auth.uid === $userId"
          }
        }
      }
    }
  }
}
